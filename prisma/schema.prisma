// **NOTE: dont remove updatedAt in any tables **
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ExportLog {
  id        String   @id @default(cuid())
  platform  String
  product   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
